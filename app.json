{
  "expo": {
    "name": "KetoInSeven",
    "slug": "ketoinseven",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ketoinseven",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#3F8F5B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ketoinseven.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ketoinseven.app",
      "adaptiveIcon": {
        "backgroundColor": "#2F6B45",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F6B45",
          "dark": {
            "backgroundColor": "#0F120F"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KetoInSeven uses the camera to read barcodes on food packaging. Images are never recorded, saved or uploaded.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-local-notifications-only",
      [
        "expo-notifications",
        {
          "color": "#3F8F5B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
